GEMINI_API_KEY=pega_aqui_tu_clave
GEMINI_MODEL=gemini-2.5-flash
# Opcional en local (si no los pones, usa un SQLite local cultura.db)
TURSO_DATABASE_URL=libsql://tu-base-tu-org.turso.io
TURSO_AUTH_TOKEN=pega_aqui_tu_token
# Opcional: protege la app con contraseña (recomendado en Render)
APP_PASSWORD=
