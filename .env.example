META_DIARIA=5
TZ_APP=Europe/Madrid
# Opcional: Telegram (solo para bot.py y recordatorio.py, no para la app web)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
APP_URL=https://tu-app.onrender.com
